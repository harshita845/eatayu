# ------------------------------------------------------------------
# Call masking (Exotel "connect two numbers"). See docs/CALL_MASKING.md
# ------------------------------------------------------------------
CALL_MASKING_ENABLED=false
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_EXOPHONE=
EXOTEL_WEBHOOK_SECRET=
EXOTEL_CALL_TIME_LIMIT_SECONDS=600
EXOTEL_RING_TIMEOUT_SECONDS=30
EXOTEL_RECORD_CALLS=false
# Public HTTPS origin of this API, used for Exotel status callbacks (e.g. https://eatayu.com)
PUBLIC_API_BASE_URL=
# Optional tuning
CALL_MASKING_POST_DELIVERY_MINUTES=30
CALL_MASKING_RATE_LIMIT_MAX=5
CALL_MASKING_RATE_LIMIT_WINDOW_SECONDS=600
