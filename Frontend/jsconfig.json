{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "paths": {
      "@food/api/axios": ["./src/services/api/axios.js"],
      "@food/api/config": ["./src/services/api/config.js"],
      "@food/api/*": ["./src/services/api/*"],
      "@food/api": ["./src/services/api"],
      "@food/*": ["./src/modules/Food/*"],
      "@food": ["./src/modules/Food"],
      "@delivery/*": ["./src/modules/DeliveryV2/*"],
      "@delivery": ["./src/modules/DeliveryV2"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}

